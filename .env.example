# Kopiér til .env og udfyld
ANTHROPIC_API_KEY=
DATABASE_URL=postgresql://odense:odense@localhost:5433/odense_rag
LLM_MODEL=anthropic:claude-opus-5-5
# Alternativ (bedre alene, men dårligere i hybrid og ca. 18x langsommere at indeksere):
# EMBED_MODEL=onnx-community/embeddinggemma-2-ONNX
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
TOP_K=5
LLM_EFFORT=low
RETRIEVAL_MODE=hybrid
MAX_CHUNKS_PER_DOC=0
KEYWORD_MAX_DF=0.05
CONTEXT_DOCS=3
